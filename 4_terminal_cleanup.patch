+    sel = (x >= 2) & (x <= max(6, xmin - 3)) & (dens > 1e-15)
+    xi = -2 / np.polyfit(x[sel], np.log(dens[sel]), 1)[0] if sel.sum() > 3 else np.nan
+    return x, dens, xi, w[idx]
