#%%
import numpy as np 
import matplotlib.pyplot as plt
#%%
# Parameters
# t1 < t2 creates the TOPOLOGICAL phase (Edge states at E=0)
t1 = 1  # Intracell hopping
t2 = 1.0  # Intercell hopping
cells = 100  # Number of unit cells
sites = 2 * cells # Total number of sites (A and B)
eta = 0.1j # Broadening
energy_array = np.linspace(-3, 3, 300)

def get_real_space_ham(t1, t2, sites):
    # Initialize zero matrix
    H = np.zeros((sites, sites))
    
    # Create the alternating hopping array: [t1, t2, t1, t2, ...]
    # We need sites-1 connections
    hoppings = np.zeros(sites - 1)
    hoppings[0::2] = t1  # Even indices (0, 2, 4...) represent intracell (A-B)
    hoppings[1::2] = t2  # Odd indices (1, 3, 5...) represent intercell (B-A')
    
    # Fill the diagonals
    # k=1 is the upper diagonal, k=-1 is the lower diagonal
    H += np.diag(hoppings, k=1)
    H += np.diag(hoppings, k=-1)
    
    return H

def get_green_function(H, energy, eta):
    size = H.shape[0]
    identity = np.eye(size)
    # G = (E + i*eta - H)^-1
    G = np.linalg.inv((energy + eta) * identity - H)
    return G

# 1. Build Hamiltonian
H_chain = get_real_space_ham(t1, t2, sites)

# 2. Calculate Local DOS at the Edge and in the Bulk
ldos_edge = np.zeros(len(energy_array))
ldos_bulk = np.zeros(len(energy_array))

# Site 0 is the left edge. Site 20 is somewhere in the middle.
edge_site_idx = 0 
bulk_site_idx = sites // 2 

for i, e in enumerate(energy_array):
    G = get_green_function(H_chain, e, eta)
    
    # LDOS = -1/pi * Im(G_ii)
    ldos_edge[i] = -1/np.pi * np.imag(G[edge_site_idx, edge_site_idx])
    ldos_bulk[i] = -1/np.pi * np.imag(G[bulk_site_idx, bulk_site_idx])

# 3. Plot results
plt.figure(figsize=(10, 6))
plt.plot(energy_array, ldos_edge, label='Edge Site (Site 0)', color='red', lw=2)
plt.plot(energy_array, ldos_bulk, label='Bulk Site (Middle)', color='blue', alpha=0.5, linestyle='--')

plt.title(f'SSH Model LDOS (Real Space Chain)\n$t_1={t1}, t_2={t2}$ (Topological Phase)')
plt.xlabel('Energy')
plt.ylabel('Local Density of States')
plt.legend()
plt.grid(True)
plt.show()
# %%
gam = .1 
Gam = 10 

x_vals = np.linspace(-20,0,300)
def expression_p(Gamma, gamma_g, omega_c):
    exp = (-1j*(Gamma+gamma_g)+np.sqrt(4*omega_c**2-(Gamma-gamma_g)**2+0j))/2
    return exp 

def expression_n(Gamma, gamma_g, omega_c):
    exp = (-1j*(Gamma+gamma_g) - np.sqrt(4*omega_c**2-(Gamma-gamma_g)**2+0j))/2
    return exp 

pos_list = []
neg_list = []
for i in range(len(x_vals)):
    pos_list.append(expression_p(Gam, gam, i))
    neg_list.append(expression_n(Gam, gam, i))


plt.figure(figsize=(12,8),dpi=150)
plt.title('Real and Imaginary parts of epxression')
plt.plot(x_vals, np.real(pos_list), c='black', label='real pos')
plt.plot(x_vals, np.imag(pos_list), c='blue', label='imag pos')
plt.plot(x_vals, np.real(neg_list), c='orange', label='real neg')
plt.plot(x_vals, np.imag(neg_list), c='magenta', label='imag neg')
plt.xlabel(r'$\Omega_c$')
plt.xlim(-20,-17.5)
plt.legend()
plt.ylim(-20,20)
plt.show()
